# Copy to .env and replace every empty value before starting Nodum.
# Never commit .env or put real credentials in this file.
POSTGRES_PASSWORD=
NODUM_ADMIN_USERNAME=
NODUM_ADMIN_PASSWORD=
NODUM_ADMIN_EMAIL=
JWT_SECRET=
NODUM_GATEWAY_ALLOWED_HOSTS=jsonplaceholder.typicode.com
NODUM_GATEWAY_ALLOW_PRIVATE_ADDRESSES=false
NODUM_GATEWAY_REMOTE_URL=http://gateway-module:8081
NODUM_MODULE_SERVICE_TOKEN=
NODUM_INFRASTRUCTURE_AGENT_URL=http://infrastructure-agent:8090
NODUM_INFRASTRUCTURE_AGENT_TOKEN=
NODUM_KAFKA_REMOTE_URL=http://kafka-module:8082
NODUM_KAFKA_REMOTE_TOKEN=
NODUM_KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
